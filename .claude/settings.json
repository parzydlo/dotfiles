{
  "model": "claude-fable-5[1m]",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/pre-tool-memory.py",
            "shell": "powershell",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 $HOME/.claude/statusline.py"
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "terminalProgressBarEnabled": true,
  "skipAutoPermissionPrompt": true
}
