{
  "model": "opus",
  "outputStyle": "Unslop",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "& $HOME/.claude/venv/Scripts/python.exe $HOME/.claude/hooks/pre-tool-memory.py",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/venv/Scripts/python.exe $HOME/.claude/statusline.py"
  },
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": true,
  "terminalProgressBarEnabled": true,
  "skipAutoPermissionPrompt": true
}
